+// Reject separators even after Unicode compatibility normalization. Encoded
+// separators must never depend on an upstream router's decoding behavior.
+function gandiPathSegment(value: string): string {
+  const normalized = value.normalize('NFKC');
+  if (!normalized || normalized === '.' || normalized === '..' || /[\\/\?#%]/.test(normalized)) {
+    throw new Error('Invalid Gandi request path component');
+  }
+  return encodeURIComponent(value);
