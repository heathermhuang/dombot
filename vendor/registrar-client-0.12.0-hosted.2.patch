+// Reject separators even after Unicode compatibility normalization. Encoded
+// separators must never depend on an upstream router's decoding behavior.
+function gandiPathSegment(value: string): string {
+  const normalized = value.normalize('NFKC');
+  if (!normalized || normalized === '.' || normalized === '..' || /[\\/\?#%]/.test(normalized)) {
+    throw new Error('Invalid Gandi request path component');
+  }
+  return encodeURIComponent(value);
+}
+
+function gandiDomainPath(value: string): string {
+  gandiPathSegment(value);
+  let hostname: string;
+  try {
+    if (/[\s:@\[\]]/.test(value)) throw new Error();
+    hostname = new URL('https://' + value).hostname.replace(/\.$/, '');
+  } catch {
+    throw new Error('Invalid Gandi domain path component');
+  }
+  const labels = hostname.split('.');
+  if (hostname.length > 253 || labels.length < 2 || /^[0-9.]+$/.test(hostname) ||
+      !labels.every(label => /^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$/i.test(label))) {
+    throw new Error('Invalid Gandi domain path component');
+  }
+  return encodeURIComponent(hostname);
+}
