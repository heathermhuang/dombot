+    return undefined;
+  const years = /\b1\s*year\b/i.test(entry.unit ?? '') ? 1 : 2;
+  const valid = (raw: unknown): number | undefined => {
+    if (typeof raw !== 'number' && (typeof raw !== 'string' || !/^\d+(?:\.\d+)?$/.test(raw.trim())))
