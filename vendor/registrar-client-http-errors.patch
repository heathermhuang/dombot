+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { HttpClient } from '../src/http';
+import { DEFAULT_OPTIONS } from '../src/constants';
+import {
+  AuthenticationError,
+  AuthorizationError,
+  ConnectionError,
+  InvalidResponseError,
+  ParsingError,
+  TimeoutError,
+} from '../src/errors';
+
+const secret = 'test-api-secret';
+const client = () =>
+  new HttpClient({
+    baseUrl: 'https://api.example.test/xml.response',
+    options: { ...DEFAULT_OPTIONS, retries: 0 },
+  });
+const request = {
+  path: '',
+  query: { ApiKey: secret, ApiUser: 'private-user', Command: 'domains.getList' },
+};
+afterEach(() => vi.unstubAllGlobals());
+
+async function failure(request: Promise<unknown>): Promise<Error> {
+  try {
+    await request;
+  } catch (error) {
+    if (error instanceof Error) return error;
+    throw error;
+  }
+  throw new Error('Expected the request to fail');
+}
+
+describe('transport errors protect registrar credentials', () => {
+  it.each([
+    [401, AuthenticationError],
+    [403, AuthorizationError],
+    [500, InvalidResponseError],
+  ] as const)(
+    'keeps typed HTTP %s errors without exposing request parameters or response bodies',
+    async (status, ErrorType) => {
+      const fetchMock = vi
+        .fn<typeof fetch>()
+        .mockResolvedValue(new Response(`<html>${secret} private-user</html>`, { status }));
+      vi.stubGlobal('fetch', fetchMock);
+      const error = await failure(client().requestText(request));
+      expect(error).toBeInstanceOf(ErrorType);
+      expect(error.message).toContain(String(status));
+      expect(error.message).toContain('https://api.example.test/xml.response');
+      expect(error.message).not.toMatch(/test-api-secret|private-user|ApiKey|<html>/);
+      // Redaction must not remove the credentials from the actual API call.
+      const input = fetchMock.mock.calls[0][0];
+      const url = typeof input === 'string' ? input : input instanceof URL ? input.href : input.url;
+      expect(new URL(url).searchParams.get('ApiKey')).toBe(secret);
+    }
+  );
+
+  it('does not echo credential-bearing network errors', async () => {
+    vi.stubGlobal('fetch', vi.fn().mockRejectedValue(new Error(`Failed URL ?ApiKey=${secret}`)));
+    const error = await failure(client().requestText(request));
+    expect(error).toBeInstanceOf(ConnectionError);
+    expect(error.message).not.toMatch(/ApiKey|test-api-secret/);
+  });
+
+  it('does not echo credential-bearing timeout URLs', async () => {
+    vi.stubGlobal('fetch', vi.fn().mockRejectedValue(new DOMException('aborted', 'AbortError')));
+    const error = await failure(client().requestText(request));
+    expect(error).toBeInstanceOf(TimeoutError);
+    expect(error.message).not.toMatch(/ApiKey|test-api-secret/);
+  });
+
+  it('does not echo malformed response content or URL credentials', async () => {
+    vi.stubGlobal('fetch', vi.fn().mockResolvedValue(new Response(`not-json ${secret}`)));
+    const error = await failure(
+      client().request({
+        path: `https://private-user:${secret}@api.example.test/data?token=${secret}#${secret}`,
+      })
+    );
+    expect(error).toBeInstanceOf(ParsingError);
+    if (!(error instanceof ParsingError)) throw error;
+    expect(error.message).not.toMatch(/test-api-secret|private-user|not-json|token=/);
+  });
+});
