{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "alternative-domains-portfolio",
  "account_id": "63a7fe52c985c63bb9e69ce47efdc569",
  "main": "../src/hosted/portfolio-clone.ts",
  "compatibility_date": "2026-10-08",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../public-portfolio",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "404-page",
  },
  "services": [{ "binding": "LEGACY", "service": "dombot" }],
  "routes": [
    {
      "pattern": "alternative.domains/*",
      "zone_id": "e692d7f87e93b565f85445f4abbfcf36",
    },
  ],
  "observability": { "enabled": true, "redact_query_string": true },
}
