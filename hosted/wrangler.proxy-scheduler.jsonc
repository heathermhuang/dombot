{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "domains-shared-proxy-scheduler",
  "main": "../src/hosted/proxy-scheduler.ts",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      { "name": "SHARED_PROXY_QUEUE", "class_name": "SharedProxyQueue" },
    ],
  },
  "migrations": [
    {
      "tag": "shared-proxy-queue-v1",
      "new_sqlite_classes": ["SharedProxyQueue"],
    },
  ],
  "vars": {
    "SHARED_PROXY_IP": "194.153.254.242",
    "SHARED_PROXY_MODE": "serial",
    "SHARED_PROXY_CONCURRENCY": "1",
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false },
    "redact_query_string": true,
  },
}
