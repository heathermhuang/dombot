{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "domains-staging",
  "main": "../src/hosted/gateway.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../site/public",
    "binding": "LANDING_ASSETS",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "CONTROL_DB",
      "database_name": "domains-staging-control",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations",
    },
  ],
  "services": [
    { "binding": "WORKSPACE_0", "service": "domains-staging-tenant-0" },
    { "binding": "WORKSPACE_1", "service": "domains-staging-tenant-1" },
    { "binding": "WORKSPACE_2", "service": "domains-staging-tenant-2" },
  ],
  "send_email": [
    {
      "name": "SALES_EMAIL",
      "allowed_sender_addresses": ["sales@mail.domains.domains"],
      "remote": false,
    },
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["accounts@mail.domains.domains"],
      "remote": false,
    },
  ],
  "vars": {
    "WORKSPACES": "[]",
    "SOURCE_COMMIT": "",
    "PUBLIC_REGISTRATION_ENABLED": "false",
    "EMAIL_FROM": "accounts@mail.domains.domains",
    "EMAIL_DELIVERY_VERIFIED": "false",
    "PUBLIC_SIGNUP_IDS": "",
    "SALES_MAIL_ENABLED": "false",
    "SALES_MAIL_DELIVERY_VERIFIED": "false",
    "SALES_EMAIL_FROM": "sales@mail.domains.domains",
    "SALES_MAIL_DAILY_LIMIT": "0",
    "SALES_MAIL_MONTHLY_LIMIT": "0",
    "SALES_CUSTOM_HOSTS_ENABLED": "false",
    "LEGAL_OPERATOR_NAME": "Magic Crystal Limited",
    "LEGAL_JURISDICTION": "Hong Kong",
  },
  "triggers": { "crons": ["17 * * * *", "*/2 * * * *"] },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false },
    "redact_query_string": true,
  },
}
