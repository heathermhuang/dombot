{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "domains-staging-tenant-0",
  "main": "../src/hosted/tenant.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "domains-staging-tenant-0",
      "database_id": "00000000-0000-0000-0000-000000000002",
      "migrations_dir": "../migrations",
    },
  ],
  "vars": {
    "DOMBOT_AUTH": "gateway",
    "DOMBOT_WORKSPACE_ID": "00000000-0000-4000-8000-000000000000",
    "DOMBOT_PUBLIC_BASE_PATH": "/w/00000000-0000-4000-8000-000000000000",
  },
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
}
